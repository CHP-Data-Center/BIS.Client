# Chỉ dùng để KIỂM THỬ giao diện: `npx vite --port 5199 --mode verify` (xem .claude/launch.json,
# mục "bis-client-verify") sẽ trỏ API sang máy chủ kiểm thử chạy SQLite ở cổng 8011 — KHÔNG đụng
# Cloud SQL production và không ảnh hưởng .env.local (cổng 8010) của phiên làm việc khác.
# Xóa file này bất cứ lúc nào nếu không cần kiểm thử nữa.
VITE_API_BASE_URL=http://127.0.0.1:8011/api/v1
